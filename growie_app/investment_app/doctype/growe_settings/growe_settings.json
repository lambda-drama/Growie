   "fieldname": "holdings_import_help",
   "fieldtype": "HTML",
   "label": "Stock holdings import",
   "options": "<p class=\"text-muted\">Use <b>Holdings → Upload stock holdings</b> to import an Excel file for a Growe Member. Expected columns: Purchase Dates, Investment, Ticker Number, <b>API Ticker Number</b> (stored as US Ticker Number), ISO MIC Exchange, Broker, Shares Breakdown, Buying Price, Goal.</p>"
  },
  {
   "fieldname": "exchange_platform_migration_help",
   "fieldtype": "HTML",
   "label": "Exchange platform IDs",
   "options": "<p class=\"text-muted\">Legacy Growe Exchange Platform records used <code>platform_name</code> as the document ID (e.g. <code>NASDAQ</code>, <code>LSE</code>). New records use <code>exchange_code</code> (e.g. <code>XNAS</code>, <code>XLON</code>).</p><p class=\"text-muted\">Use the button below to rename existing platforms in the background, update Growe Stock and price-cache links, merge duplicates, then refresh Growe Stock names. Platforms without an <code>exchange_code</code> are skipped — fill those in first.</p>"
  },
  {
   "fieldname": "last_exchange_platform_migration",
   "fieldtype": "Small Text",
   "label": "Last exchange platform migration",
   "read_only": 1
  },
  {
   "fieldname": "stock_naming_migration_help",
   "fieldtype": "HTML",
   "label": "Growe Stock naming",
   "options": "<p class=\"text-muted\">Legacy Growe Stock names used <code>ticker-company_name</code> (e.g. <code>KPLC-Kenya Power</code>). New records use <code>ticker-exchange_platform</code> (e.g. <code>KPLC-NSE</code>).</p><p class=\"text-muted\">Use the button below to rename existing records in the background, re-link holdings/transactions, merge duplicates, and remove old names.</p>"
  },
